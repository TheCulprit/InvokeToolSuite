{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Invoke Tool Suite",
  "version": "0.1.1",
  "identifier": "com.invoke.tool-suite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Invoke Tool Suite",
        "width": 1480,
        "height": 980,
        "minWidth": 1120,
        "minHeight": 760,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
